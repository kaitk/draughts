+/* A block-compressed format: sampled, never drawn into, uploaded in whole
+   blocks. */
+static bool gfx_is_compressed(int32_t format) {
+    return format >= GS_GFX_BC1 && format <= GS_GFX_ASTC_8x8;
+}
