 #ifdef _WIN32
+/* FXC takes seconds for a large shader (2.7 s for 34 KB of HLSL on a desktop CPU), and a
+   program makes its pipelines at launch, so each launch waited on every compile again.
+   The DXBC is kept on disk instead, as the GPU drivers keep their own compiles: in
+   %LOCALAPPDATA%\goose_gfx\dxbc\, named by a hash of the HLSL and the target, and read
+   back by the next launch. A file is written whole and then renamed into place, and one
+   that isn't DXBC of the length its header gives is compiled again. */
+static bool gfx_dxbc_path(char *path, size_t n, const char *hlsl, size_t len, const char *target) {
+    const char *base = SDL_getenv("LOCALAPPDATA");
+    if (!base || !*base) return false;
+    uint64_t hash = 14695981039346656037ull;
+    for (size_t i = 0; i < len; i++) hash = (hash ^ (uint8_t)hlsl[i]) * 1099511628211ull;
+    for (const char *t = target; *t; t++) hash = (hash ^ (uint8_t)*t) * 1099511628211ull;
+    int k = SDL_snprintf(path, n, "%s\\goose_gfx\\dxbc\\%016llx-%s.dxbc", base,
+                         (unsigned long long)hash, target);
+    return k > 0 && (size_t)k < n;
+}
+
+static bool gfx_dxbc_load(const char *path, void **code, size_t *size) {
+    size_t n = 0;
+    uint8_t *data = (uint8_t *)SDL_LoadFile(path, &n);
+    if (!data) return false;
+    uint32_t total = 0;
+    if (n >= 32) memcpy(&total, data + 24, 4);
+    bool ok = n >= 32 && memcmp(data, "DXBC", 4) == 0 && total == n;
+    if (ok) {
+        *code = malloc(n);
+        memcpy(*code, data, n);
+        *size = n;
+    }
+    SDL_free(data);
+    return ok;
+}
+
+static void gfx_dxbc_save(const char *path, const void *code, size_t size) {
+    char dir[1024], tmp[1100];
+    SDL_strlcpy(dir, path, sizeof dir);
+    char *slash = SDL_strrchr(dir, '\\');
+    if (!slash) return;
+    *slash = 0;
+    SDL_snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentProcessId());
+    if (SDL_CreateDirectory(dir) && SDL_SaveFile(tmp, code, size) && !SDL_RenamePath(tmp, path))
+        SDL_RemovePath(tmp);
+}
+
 static bool gfx_compile_hlsl(const char *hlsl, size_t len, int stage, void **code, size_t *size) {
     static const char *targets[] = { "vs_5_1", "ps_5_1", "cs_5_1" };
+    char path[1024];
+    bool cached = gfx_dxbc_path(path, sizeof path, hlsl, len, targets[stage]);
+    if (cached && gfx_dxbc_load(path, code, size)) return true;
     ID3DBlob *out = NULL, *errors = NULL;
     HRESULT hr = ((gfx_d3dcompile_fn)gfx.d3dcompile)(hlsl, len, "embedded shader", NULL, NULL,
                                                      "main", targets[stage], 0, 0, &out, &errors);
@@ -58,6 +105,7 @@
     memcpy(*code, ID3D10Blob_GetBufferPointer(out), *size);
     ID3D10Blob_Release(out);
     if (errors) ID3D10Blob_Release(errors);
+    if (cached) gfx_dxbc_save(path, *code, *size);
     return true;
 }
 #endif
