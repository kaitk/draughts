+// The element access an SSBO write's target `lv` starts from (`buf[i]`), or NULL
+// when `lv` lies outside every SSBO. Fills `chain` with the member and index
+// nodes between them, outermost first.
+static cspv_expr* cspv_hlsl_ssbo_root(cspv_tp* g, cspv_expr* lv, cspv_expr** chain, int* n, cspv_decl** d)
+{
+	*n = 0;
+	for (cspv_expr* e = lv; *n < 16; ) {
+		if (e->kind == CSPV_E_INDEX) {
+			*d = cspv_hlsl_ssbo(g, e->u.index.base);
+			if (*d) return e;
+			chain[(*n)++] = e;
+			e = e->u.index.base;
+		} else if (e->kind == CSPV_E_MEMBER) {
+			chain[(*n)++] = e;
+			e = e->u.member.base;
+		} else {
+			return NULL;
+		}
+	}
+	return NULL;
+}
