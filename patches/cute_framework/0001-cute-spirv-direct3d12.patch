+static void test_hlsl_reserved_names(void)
+{
+	// GLSL names FXC rejects (keywords, type names), or that would overload an
+	// intrinsic the printer emits, gain a trailing underscore in HLSL only.
+	CSPV_Result r = s_emit_all(CSPV_STAGE_VERTEX,
+		"layout(location = 0) in vec3 line;\n"
+		"layout(location = 0) out vec4 texture;\n"
+		"struct triangle { vec3 vector; float linear; };\n"
+		"layout(std430, set = 0, binding = 0) readonly buffer B { triangle matrix[]; };\n"
+		"float float2(float point) { return point * 2.0; }\n"
+		"vec3 lerp(vec3 a, vec3 b, float t) { return mix(a, b, t); }\n"
+		"void main() {\n"
+		"	triangle t = matrix[gl_InstanceIndex];\n"
+		"	texture = vec4(lerp(t.vector, line, float2(t.linear)), 1.0);\n"
+		"	gl_Position = texture;\n"
+		"}\n");
+	if (r.success) {
+		CHECK(strstr(r.hlsl, "line_ = cf_in.line__in;") != NULL);
+		CHECK(strstr(r.hlsl, "cf_out.texture__out = texture_;") != NULL);
+		CHECK(strstr(r.hlsl, "struct triangle_") != NULL);
+		CHECK(strstr(r.hlsl, "float3 vector_;") != NULL);
+		CHECK(strstr(r.hlsl, "ByteAddressBuffer matrix_ :") != NULL);
+		CHECK(strstr(r.hlsl, "float float2_(float point_)") != NULL);
+		CHECK(strstr(r.hlsl, "float3 lerp_(float3 a, float3 b, float t)") != NULL);
+		CHECK(strstr(r.hlsl, "return lerp(a, b, t);") != NULL);
+		CHECK(strstr(r.msl, "line_") == NULL);
+	}
+	cspv_free(&r);
+}
