+static void test_hlsl_storage_buffers(void)
+{
+	// SDL_GPU's D3D12 backend views storage buffers as raw, so SSBOs are byte-address
+	// buffers whose elements load and store at their std430 offsets.
+	{
+		CSPV_Result r = s_emit_all(CSPV_STAGE_VERTEX,
+			"layout(std430, set = 0, binding = 0) readonly buffer Inst { vec4 inst[]; };\n"
+			"void main() { gl_Position = inst[gl_InstanceIndex * 2 + 1] + float(inst.length()); }\n");
+		if (r.success) {
+			CHECK(strstr(r.hlsl, "StructuredBuffer") == NULL);
+			CHECK(strstr(r.hlsl, "ByteAddressBuffer inst : register(t0, space0);") != NULL);
+			CHECK(strstr(r.hlsl, "cf_v = asfloat(inst.Load4(cf_a + 0));") != NULL);
+			CHECK(strstr(r.hlsl, "inst_ld(gl_InstanceIndex * 2 + 1)") != NULL);
+			CHECK(strstr(r.hlsl, "inst.GetDimensions(b); return b / 16u;") != NULL);
+		}
+		cspv_free(&r);
+	}
+	{
+		CSPV_Result r = s_emit_all(CSPV_STAGE_COMPUTE,
+			"layout(local_size_x = 64) in;\n"
+			"struct P { vec3 pos; float life; vec2 vel; int kind; uint hits; };\n"
+			"layout(std430, set = 1, binding = 0) buffer Parts { P parts[]; };\n"
+			"layout(std430, set = 1, binding = 1) buffer Lows { int lows[]; };\n"
+			"void main() {\n"
+			"	uint i = gl_GlobalInvocationID.x;\n"
+			"	P p = parts[i];\n"
+			"	parts[i] = p;\n"
+			"	parts[i].pos.xz = p.vel;\n"
+			"	parts[i].pos.y += 0.5;\n"
+			"	parts[i].kind++;\n"
+			"	parts[i].pos[int(i) % 3] = 9.0;\n"
+			"	atomicAdd(parts[i].hits, 2u);\n"
+			"	atomicMin(lows[0], p.kind);\n"
+			"}\n");
+		if (r.success) {
+			CHECK(strstr(r.hlsl, "RWByteAddressBuffer parts : register(u0, space1);") != NULL);
+			CHECK(strstr(r.hlsl, "cf_v.life = asfloat(parts.Load(cf_a + 12));") != NULL);
+			CHECK(strstr(r.hlsl, "cf_v.kind = asint(parts.Load(cf_a + 24));") != NULL);
+			CHECK(strstr(r.hlsl, "parts.Store2(cf_a + 16, asuint(cf_v.vel));") != NULL); // parts[i] = p
+			CHECK(strstr(r.hlsl, "parts.Store(cf_a + 8, asuint(cf_v[1]));") != NULL);    // .xz =
+			CHECK(strstr(r.hlsl, "cf_o = asfloat(parts.Load(cf_a + 4));") != NULL);      // .y +=
+			CHECK(strstr(r.hlsl, "uint cf_a = cf_i * 32u + 0u + cf_j * 4u;") != NULL);  // pos[k] =
+			CHECK(strstr(r.hlsl, "parts.InterlockedAdd(cf_a, cf_v);") != NULL);
+			CHECK(strstr(r.hlsl, "lows.InterlockedMin(cf_a, cf_v);") != NULL);
+		}
+		cspv_free(&r);
+	}
+	const char* cs = "layout(local_size_x = 64) in;\n"
+		"layout(std430, set = 1, binding = 0) buffer B { vec4 b[]; };\n"
+		"void inc(inout float x) { x += 1.0; }\n";
+	char src[512];
+	CSPV_Options opts;
+	memset(&opts, 0, sizeof(opts));
+	opts.emit_hlsl = true;
+	snprintf(src, sizeof(src), "%svoid main() { float y = b[0].x = 2.0; }\n", cs);
+	expect_err_ex(CSPV_STAGE_COMPUTE, src, "storage buffer writes must be statements in HLSL output", &opts);
+	snprintf(src, sizeof(src), "%svoid main() { inc(b[0].y); }\n", cs);
+	expect_err_ex(CSPV_STAGE_COMPUTE, src, "out/inout argument is not supported in HLSL output", &opts);
+	snprintf(src, sizeof(src), "%svoid main() { b[0].zw[1] = 2.0; }\n", cs);
+	expect_err_ex(CSPV_STAGE_COMPUTE, src, "a swizzle inside a storage buffer write target", &opts);
+}
