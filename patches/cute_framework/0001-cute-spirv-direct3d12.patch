+static bool cspv_hlsl_validate_is_ssbo(cspv_ctx* ctx, cspv_expr* e)
+{
+	for (int i = 0; i < (int)asize(ctx->decls); i++) {
+		cspv_decl* d = ctx->decls + i;
+		if (d->kind != CSPV_D_BLOCK || !d->is_buffer || d->num_members != 1) continue;
+		if (e->kind == CSPV_E_REF && !d->instance_name && d->member_names[0] == e->u.name) return true;
+		if (e->kind == CSPV_E_MEMBER && e->u.member.base->kind == CSPV_E_REF &&
+		    d->instance_name == e->u.member.base->u.name && d->member_names[0] == e->u.member.member) {
+			return true;
+		}
+	}
+	return false;
