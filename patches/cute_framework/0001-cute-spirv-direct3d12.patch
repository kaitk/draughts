+static bool cspv_hlsl_validate_ssbo_target(cspv_ctx* ctx, cspv_expr* e)
+{
+	bool inner_swizzle = false;
+	for (cspv_expr* c = e; c->kind == CSPV_E_INDEX || c->kind == CSPV_E_MEMBER; ) {
+		if (c->kind == CSPV_E_INDEX) {
+			if (cspv_hlsl_validate_is_ssbo(ctx, c->u.index.base)) {
+				if (inner_swizzle) cspv_errorf(ctx, e->line, "a swizzle inside a storage buffer write target is not supported in HLSL output");
