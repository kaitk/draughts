+//--------------------------------------------------------------------------------------------------
+// HLSL storage buffers.
+//
+// SDL_GPU's D3D12 backend views every storage buffer as raw (R32_TYPELESS with
+// the RAW flag on its SRV and UAV), the view a ByteAddressBuffer takes and the
+// one SPIRV-Cross's HLSL expects. A StructuredBuffer read through a raw view is
+// undefined: NVIDIA's driver returns the data, AMD's returns zeros and drops
+// writes. So each SSBO is a (RW)ByteAddressBuffer whose elements load and store
+// at their std430 byte offsets. A read calls the buffer's `<name>_ld(i)`, which
+// assembles the element. Each write into an element -- an assignment, compound
+// assignment, ++/--, or atomic -- calls a helper of its own, `<name>_st<n>(i,
+// <dynamic indices>, [compare,] value)`, printed ahead of its function.
+
+// The SSBO an index base `e` names (an unshadowed member of an unnamed buffer
+// block, or `inst.member` of a named one), or NULL.
+static cspv_decl* cspv_hlsl_ssbo(cspv_tp* g, cspv_expr* e)
+{
+	if (e->kind == CSPV_E_MEMBER) return cspv_tp_named_buffer_member(g, e);
+	if (e->kind != CSPV_E_REF) return NULL;
+	for (int i = (int)asize(g->shadows) - 1; i >= 0; i--) {
+		if (g->shadows[i] == e->u.name) return NULL;
+	}
+	for (int i = 0; i < (int)asize(g->ctx->decls); i++) {
+		cspv_decl* d = g->ctx->decls + i;
+		if (d->kind == CSPV_D_BLOCK && d->is_buffer && !d->instance_name && d->num_members == 1 &&
+		    d->member_names[0] == e->u.name) {
+			return d;
 		}
 	}
-	sappend(ctx->tp_out, "};\n");
+	return NULL;
+}
+
+// The resource an SSBO prints as: its member's name, or `inst_member`.
+static const char* cspv_hlsl_ssbo_name(cspv_tp* g, cspv_decl* d)
+{
+	if (!d->instance_name) return cspv_tp_id(g, d->member_names[0]);
+	char buf[256];
+	snprintf(buf, sizeof(buf), "%s_%s", d->instance_name, d->member_names[0]);
+	return sintern(buf);
+}
+
+// std430 array stride of `t`.
+static int cspv_hlsl_stride(cspv_ctx* ctx, cspv_type* t)
+{
+	int align = 0, size = 0;
+	cspv_std430_layout(ctx, t, 0, &align, &size);
+	return (size + align - 1) / align * align;
+}
+
+// std430 offset of field `k` in struct `t`.
+static int cspv_hlsl_field_offset(cspv_ctx* ctx, cspv_type* t, int k)
+{
+	int offset = 0;
+	for (int i = 0; i < k; i++) {
+		int fa = 0, fs = 0;
+		cspv_std430_layout(ctx, t->field_types[i], 0, &fa, &fs);
+		offset = (offset + fa - 1) / fa * fa + fs;
+	}
+	int fa = 0, fs = 0;
+	cspv_std430_layout(ctx, t->field_types[k], 0, &fa, &fs);
+	return (offset + fa - 1) / fa * fa;
+}
+
+// The bit cast from a raw load's uint/uintN to `t`'s element kind.
+static const char* cspv_hlsl_from_bits(cspv_type* t)
+{
+	switch (cspv_elem_type(t)->kind) {
+	case CSPV_T_FLOAT: return "asfloat";
+	case CSPV_T_INT: return "asint";
+	default: return "";
+	}
+}
+
+// Prints statements that load (`load`) or store `path`, a value of type `t`, at
+// byte `cf_a + off` of buffer `buf`: each scalar or vector at its std430 offset
+// (buffer-block struct fields are scalars or vectors only).
+static void cspv_hlsl_ssbo_leaves(cspv_tp* g, CK_SDYNA char** out, bool load, const char* buf, cspv_type* t, int off, const char* path)
+{
+	if (t->kind == CSPV_T_STRUCT) {
+		char sub[512];
+		for (int i = 0; i < (int)asize(t->field_types); i++) {
+			snprintf(sub, sizeof(sub), "%s.%s", path, cspv_tp_id(g, t->field_names[i]));
+			cspv_hlsl_ssbo_leaves(g, out, load, buf, t->field_types[i], off + cspv_hlsl_field_offset(g->ctx, t, i), sub);
+		}
+		return;
+	}
+	static const char* width[5] = { "", "", "2", "3", "4" };
+	int n = t->kind == CSPV_T_VEC ? t->cols : 1;
+	if (load) sfmt_append(*out, "\t%s = %s(%s.Load%s(cf_a + %d));\n", path, cspv_hlsl_from_bits(t), buf, width[n], off);
+	else sfmt_append(*out, "\t%s.Store%s(cf_a + %d, asuint(%s));\n", buf, width[n], off, path);
+}
+
+// Declares SSBO `d`: the resource, its element count, and its load helper.
+static void cspv_hlsl_ssbo_decl(cspv_tp* g, cspv_decl* d)
+{
+	CK_SDYNA char** out = &g->ctx->tp_out;
+	const char* name = cspv_hlsl_ssbo_name(g, d);
+	cspv_type* elem = d->member_types[0]->elem;
+	int stride = cspv_hlsl_stride(g->ctx, elem);
+	const char* type = cspv_tp_type_name(g, elem);
+	sfmt_append(*out, "%sByteAddressBuffer %s : register(%c%d, space%d);\n",
+		d->readonly ? "" : "RW", name, d->readonly ? 't' : 'u', d->binding, d->set);
+	sfmt_append(*out, "uint %s_len() { uint b; %s.GetDimensions(b); return b / %du; }\n", name, name, stride);
+	sfmt_append(*out, "%s %s_ld(uint cf_i)\n{\n\tuint cf_a = cf_i * %du;\n\t%s cf_v;\n", type, name, stride, type);
+	cspv_hlsl_ssbo_leaves(g, out, true, name, elem, 0, "cf_v");
+	sappend(*out, "\treturn cf_v;\n}\n");
+}
+
+// Loads or stores a scalar or vector lvalue `v` of `n` components, component k
+// at byte `cf_a + comps[k] * 4` (one Load/StoreN when they are consecutive).
+static void cspv_hlsl_ssbo_comps(CK_SDYNA char** out, bool load, const char* buf, cspv_type* t, const int* comps, int n, const char* v)
+{
+	static const char* width[5] = { "", "", "2", "3", "4" };
+	bool run = true;
+	for (int k = 1; k < n; k++) run = run && comps[k] == comps[0] + k;
+	if (run) {
+		if (load) sfmt_append(*out, "\t%s = %s(%s.Load%s(cf_a + %d));\n", v, cspv_hlsl_from_bits(t), buf, width[n], comps[0] * 4);
+		else sfmt_append(*out, "\t%s.Store%s(cf_a + %d, asuint(%s));\n", buf, width[n], comps[0] * 4, v);
+		return;
+	}
+	for (int k = 0; k < n; k++) {
+		if (load) sfmt_append(*out, "\t%s[%d] = %s(%s.Load(cf_a + %d));\n", v, k, cspv_hlsl_from_bits(t), buf, comps[k] * 4);
+		else sfmt_append(*out, "\t%s.Store(cf_a + %d, asuint(%s[%d]));\n", buf, comps[k] * 4, v, k);
+	}
+}
