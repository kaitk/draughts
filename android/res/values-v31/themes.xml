<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own splash, the app icon on this colour, until the first
         frame: the same colour, so no image of our own and no flash between them. The bars'
         backgrounds are that colour too (values/themes.xml). -->
    <style name="Theme.Draughts" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/icon_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/icon_background</item>
        <item name="android:windowSplashScreenBackground">@color/icon_background</item>
    </style>
</resources>
