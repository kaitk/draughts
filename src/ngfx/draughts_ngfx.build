// The program's own C (src/app/draughts.build's, every file of it: scripts/ngfx.py checks),
// goose-ngfx's upload of the photograph beside gfx's (photo_ngfx.c), and the check before a
// window (renderer.c). build/ngfx/ holds goose-ngfx's link and draughts_version.h, which
// scripts/ngfx.py makes.
c_sources = ["../app/background.c", "../app/display.c", "../app/gfx_fork.c", "../app/launch.c", "../app/locale.c",
             "../app/memory.c", "../app/photo.c", "../app/resize.c", "../app/storage.c", "../app/wake.c",
             "photo_ngfx.c", "renderer.c"];
c_include = ["../app", "../../build/ngfx", "../../build/ngfx/goose-ngfx/native",
             "../../third_party/goose_gfx/third_party/nuklear/demo/common/filebrowser",
             "../../third_party/goose_gfx/src/gfx", "../../third_party/goose_gfx/third_party/SDL/src/video/khronos"];
