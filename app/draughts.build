// The program's own C: the season's photograph, uploaded through gfx's C API (its
// header's folder below), and its JPEG decoder (docs/architecture/rendering.md, "Scene
// and glass"), the system's locales, the app's storage folder, the window's safe area
// and display scale, the wake a running clock asks for, and what the program tells
// Android (its first frame, and closing), and the freed memory malloc keeps, given back
// after the launch. scripts/android.py reads c_sources and c_include from here too.
c_sources = ["background.c", "display.c", "launch.c", "locale.c", "memory.c", "storage.c", "wake.c"];
c_include = ["../third_party/goose_gfx/third_party/nuklear/demo/common/filebrowser",
             "../third_party/goose_gfx/src/gfx"];
