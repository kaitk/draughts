// The program's own C: the season's photograph and its JPEG decoder
// (docs/architecture/rendering.md, "Scene and glass"), the system's locales, the app's
// storage folder, the window's safe area and display scale, the wake a running clock
// asks for, and what the program tells
// Android (its first frame, and closing). scripts/android.py reads c_sources and
// c_include from here too.
c_sources = ["background.c", "display.c", "launch.c", "locale.c", "storage.c", "wake.c"];
